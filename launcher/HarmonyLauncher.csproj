<Project Sdk="Microsoft.NET.Sdk">

  <!-- HarmonyRecomp launcher: picks the player's own game package (and DLC),
       fetches the portable build tools, runs scripts/build.py and starts the game.
       Publish a single self-contained exe with:
         dotnet publish launcher -c Release
       Output: launcher/bin/Release/net10.0/win-x64/publish/HarmonyLauncher.exe -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HarmonyLauncher</AssemblyName>
    <RootNamespace>HarmonyLauncher</RootNamespace>
    <Version>0.1.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

</Project>
